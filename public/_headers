# Cloudflare Pages response headers: https://developers.cloudflare.com/pages/configuration/headers/

# Every response, the 404 page included, gets the security headers:
# - the Content-Security-Policy loads scripts, styles, images and the manifest from the site only,
#   plus the inline style of 404.html by its hash, which every edit of that block changes
#   (e2e/headers.spec.ts prints the new one). It forbids a <base>, any form target and any frame
#   around the page;
# - HSTS keeps the browsers on HTTPS for a year;
# - the Permissions-Policy turns off the camera, the microphone and the geolocation.
/*
  Content-Security-Policy: default-src 'self'; style-src 'self' 'sha256-dlGtZ/xt/XGJjnZR+rgk7uMeQ/Ktfln7zEUSLqZvkHo='; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000

# Hashed build assets never change under the same name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The page is revalidated on every visit, so a deploy shows at once.
/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache
